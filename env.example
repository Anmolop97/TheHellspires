# Copy this file to .env and add your own Gemini API key.
# Never commit .env or share your key publicly.
GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Optional: set this only if you intentionally access the API from one other origin.
# For the included same-origin app, leave it blank.
ALLOWED_ORIGIN=
